@model MM_client.Models.CreateMarathonViewModel
@{
    ViewData["Title"] = "Tạo Marathon";
}

<h2 class="mb-4">Tạo Marathon Mới</h2>

<!-- ✅ Display messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-controller="Marathons" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="MarathonName" class="form-label"></label>
        <input asp-for="MarathonName" class="form-control" />
        <span asp-validation-for="MarathonName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="RegistrationFee" class="form-label"></label>
            <input asp-for="RegistrationFee" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants" type="number" class="form-control" />
        </div>
    </div>

    <hr />
    <h4>Chọn Checkpoint trên bản đồ</h4>
    <div id="map" style="height: 400px; border-radius: 10px;"></div>
    <input type="hidden" id="checkpointsData" name="CheckpointsJson" />

    <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary">Tạo Marathon</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script>
        let map = L.map('map').setView([21.0285, 105.8542], 13); // default: Hanoi
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19
        }).addTo(map);

        let checkpoints = [];
        let markers = [];

        map.on('click', function (e) {
            const { lat, lng } = e.latlng;
            const sequence = checkpoints.length + 1;
            const marker = L.marker([lat, lng])
                .addTo(map)
                .bindPopup(`Checkpoint ${sequence}`)
                .openPopup();

            markers.push(marker);
            checkpoints.push({
                Name: `Checkpoint ${sequence}`,
                Latitude: lat,
                Longitude: lng,
                Sequence: sequence
            });

            document.getElementById('checkpointsData').value = JSON.stringify(checkpoints);
        });
    </script>
}
