@model MM_client.Models.ReadMarathonDetailDTO

@{
    ViewData["Title"] = "Chi tiết Marathon";
}

<h2>@Model.MarathonName</h2>

<div class="marathon-detail">
    <img src="@Model.ThumbnailLink" alt="Thumbnail"
         style="width:100%; max-width:600px; border-radius:8px; margin-bottom:20px;" />

    <p><strong>Nhà tổ chức:</strong> @Model.OrganizerName</p>
    <p><strong>Địa điểm:</strong> @Model.Location</p>
    <p><strong>Thời gian:</strong> @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</p>
    <p><strong>Lệ phí:</strong> @Model.RegistrationFee.ToString("N0") VNĐ</p>
    <p><strong>Tình trạng:</strong> @Model.Status</p>
    <p><strong>Mô tả:</strong> @Model.Description</p>

    <div style="margin-top:20px;">
        <form asp-controller="Payment" asp-action="Register" asp-route-marathonId="@Model.MarathonId" method="post">
            <button type="submit" class="btn btn-primary">
                Đăng ký tham gia
            </button>
        </form>
        @if (TempData["Error"] != null){
                if (TempData["Error"].Equals("Bạn đã đăng ký giải đấu này rồi."))
                {
                    <p>@TempData["Error"]</p>
                }
        }
    </div>

    <h3 style="margin-top:40px;">Bản đồ lộ trình</h3>
    <div id="map" style="height:500px; width:100%; border-radius:8px; margin-top:10px; background:#eee;"></div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Serialize checkpoints safely
            const checkpoints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Checkpoints ?? new List<ReadCheckpointDTO>()));

            if (Array.isArray(checkpoints) && checkpoints.length > 0) {
                // Parse first checkpoint coordinates
                const first = checkpoints[0];
                const firstLat = parseFloat(first.latitude ?? first.Latitude);
                const firstLon = parseFloat(first.longitude ?? first.Longitude);

                if (isNaN(firstLat) || isNaN(firstLon)) {
                    document.getElementById('map').innerHTML = '<p>Không thể xác định tọa độ của checkpoint đầu tiên.</p>';
                    return;
                }

                // Initialize map centered on the first checkpoint
                const map = L.map('map').setView([firstLat, firstLon], 15);

                // Add OpenStreetMap layer
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors'
                }).addTo(map);

                const points = [];

                // Add markers and collect line points
                checkpoints.forEach((cp, index) => {
                    const lat = parseFloat(cp.latitude ?? cp.Latitude);
                    const lon = parseFloat(cp.longitude ?? cp.Longitude);

                    if (!isNaN(lat) && !isNaN(lon)) {
                        const marker = L.marker([lat, lon]).addTo(map);
                        marker.bindPopup(`<strong>${cp.name ?? cp.Name ?? 'Checkpoint ' + (index + 1)}</strong><br>Thứ tự: ${cp.sequence ?? cp.Sequence}`);
                        points.push([lat, lon]);
                    }
                });

                // Draw a cyan route line
                if (points.length > 1) {
                    L.polyline(points, { color: 'cyan', weight: 5, opacity: 0.9 }).addTo(map);
                }

                // Ensure map displays fully after load
                setTimeout(() => map.invalidateSize(), 300);
            } else {
                document.getElementById('map').innerHTML = '<p>Không có checkpoint nào được đăng ký.</p>';
            }
        });
    </script>
}

