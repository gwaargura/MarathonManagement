@model MM_client.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<h2>Đăng ký</h2>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <label>Tên đăng nhập</label>
    <input asp-for="Username" class="form-control" />
    <span asp-validation-for="Username"></span>

    <label>Email</label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email"></span>

    <label>Mật khẩu</label>
    <input asp-for="Password" class="form-control" />
    <span asp-validation-for="Password"></span>

    <label>Họ và tên</label>
    <input asp-for="FullName" class="form-control" />

    <div class="form-check mt-3">
        <input asp-for="IsOrganizer" class="form-check-input" id="isOrganizer" />
        <label for="isOrganizer" class="form-check-label">Đăng ký với vai trò tổ chức</label>
    </div>

    <div id="organizerNameField" class="mt-3" style="display:none;">
        <label>Tên tổ chức</label>
        <input asp-for="OrganizationName" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Đăng ký</button>
</form>
<p class="mt-3">
    Đã có tài khoản?
    <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
</p>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const isOrganizerCheckbox = document.getElementById('isOrganizer');
        const organizerField = document.getElementById('organizerNameField');

        isOrganizerCheckbox.addEventListener('change', function () {
            organizerField.style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
