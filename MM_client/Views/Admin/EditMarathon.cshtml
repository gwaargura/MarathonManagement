@model MM_client.Models.UpdateMarathonDTO

@{
    ViewData["Title"] = "Edit Marathon";
}

<h2>Edit Marathon</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="EditMarathon" method="post" asp-route-id="@ViewBag.MarathonId">
    <div class="form-group mb-3">
        <label>Name</label>
        <input asp-for="MarathonName" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Location</label>
        <input asp-for="Location" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label>Status</label>
        <input asp-for="Status" type="text" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary">Back</a>
</form>
